{
  "regions": [
    "lhr1"
  ],
  "rewrites": [
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{1,30})",
      "has": [
        {
          "type": "host",
          "value": "go.citizengo.org"
        }
      ],
      "destination": "/api/bio?slug=:slug"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/oauth/metadata?doc=protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth/metadata?doc=protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth/metadata?doc=authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/oauth/metadata?doc=authorization-server"
    },
    {
      "source": "/links/:slug/qr.svg",
      "destination": "/api/bio?slug=:slug&qr=1"
    },
    {
      "source": "/links/:slug/p/:p",
      "destination": "/api/bio?slug=:slug&p=:p"
    },
    {
      "source": "/links/:slug/go/:go",
      "destination": "/api/bio?slug=:slug&go=:go"
    },
    {
      "source": "/links/:slug",
      "destination": "/api/bio?slug=:slug"
    },
    {
      "source": "/links",
      "destination": "/api/bio"
    },
    {
      "source": "/preview/:t",
      "destination": "/api/desk?op=preview&t=:t"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/desk/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/desk",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/bio",
      "schedule": "7 */3 * * *"
    }
  ],
  "functions": {
    "api/cron/publish.js": {
      "maxDuration": 300
    },
    "api/cron/bio.js": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "go.citizengo.org"
        }
      ],
      "destination": "/links",
      "permanent": false
    }
  ]
}
