<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Content Engine Inbox collector on the Mini (docs/content-engine-phase2.md, slice 3). Every 5 minutes: reads comments and DMs into engine_inbox. Read-only on Meta.
     Install: cp to ~/Library/LaunchAgents/ and launchctl bootstrap gui/$(id -u) <plist> -->
<plist version="1.0">
<dict>
  <key>Label</key><string>net.citizengo.content-inbox</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-c</string>
    <string>cd "$HOME/runner/meta-reports" &amp;&amp; node collector/inbox.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/content-inbox.log</string>
  <key>StandardErrorPath</key><string>/tmp/content-inbox.log</string>
</dict>
</plist>
