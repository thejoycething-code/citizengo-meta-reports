# Graph API token for the Phase 0 probe.
# Prefer a System User token from a Business Manager that owns the pilot Pages.
# A short-lived Graph API Explorer user token also works for a one-off probe.
META_TOKEN=

# Override if v23.0 is outside the supported window when you run this.
GRAPH_VERSION=v23.0

# ---------------------------------------------------------------------------
# X (Twitter) source - GROUNDWORK, all optional until go-live. See README.md.
# ---------------------------------------------------------------------------
# OAuth 2.0 app from the X developer portal (User authentication settings:
# read-only, type "Web App", callback = X_REDIRECT_URI).
X_CLIENT_ID=
X_CLIENT_SECRET=            # only for a confidential client; leave blank for a public one
X_REDIRECT_URI=https://meta-organic-reporting.vercel.app/api/x/callback

# npm run x:keygen prints all three. Private key: GitHub Actions ONLY.
# Public key: Vercel ONLY. Invite secret: both, plus here for x:invite.
X_TOKEN_PRIVATE_KEY=
X_TOKEN_PUBLIC_KEY=
X_INVITE_SECRET=

# Spend guard. The collector refuses to start once the month's estimated
# spend reaches this; the health check warns at 80%.
X_MONTHLY_BUDGET_USD=100

# One-account spike: a user-context access token for npm run probe:x, or
# "label:token,label:token" for a database-free dry run of the collector.
X_PROBE_TOKEN=
X_ACCESS_TOKENS=

# Show the X tools on the connector. Leave unset until data exists.
X_TOOLS_ENABLED=
